{
    "name": "georgringer/allowed_fields_filter",
    "description": "List only fields of permitted tables in the \"Allowed fields\" of backend user groups",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "authors": [
        {
            "name": "Georg Ringer",
            "homepage": "https://ringer.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">= 8.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "GeorgRinger\\AllowedFieldsFilter\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeorgRinger\\AllowedFieldsFilter\\Tests\\": "Tests"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "allowed_fields_filter"
        }
    }
}
